# ---------------------------------------------------------------------------
# Test Supabase project -- copy to .env.supabase-test (git-ignored) and fill in.
#
# Use a DEDICATED test project, never a production project. If it receives the
# imported Globa 3 data (README "Importing the existing Globa 3 database"), treat
# it as holding business data: real accounts only for the two testers, private
# Storage, and this file never shared. Every supabase:test:* command
# refuses to run unless all refs below agree, and refuses any ref listed as
# production in supabase/environments.json, with no override.
# ---------------------------------------------------------------------------

# Declares the target. Required for any non-local database.
G3_TARGET_ENV=test
# The 20-character ref of the TEST project (Project Settings -> General).
SUPABASE_TEST_PROJECT_REF=

# Postgres. The direct connection is simplest for migrations:
#   postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# The session pooler also works:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only for projects still on the legacy HS256 JWT secret; leave empty for JWKS.
SUPABASE_JWT_SECRET=
# Must be a PRIVATE bucket. `npm run supabase:test:preflight -- --create-bucket` creates it.
SUPABASE_STORAGE_BUCKET=workspace-files

# The dev sign-in must be off against Supabase. The wrapper forces this anyway.
DEV_AUTH_ENABLED=false

# The two users, created through the Supabase Admin API by supabase:test:bootstrap
# (imported project) or supabase:test:seed (clean project). Use real addresses you
# control and passwords that are not the local defaults. The bootstrap uses the
# passwords only when an account does not exist yet.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_CLIENT_EMAIL=
SEED_CLIENT_PASSWORD=

# Optional. Without it the mock provider runs and results are labelled synthetic.
# OPENAI_API_KEY=
