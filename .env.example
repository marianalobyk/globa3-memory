# ---------------------------------------------------------------------------
# Globa 3 Intelligence Platform — environment template
#
# Copy to .env.local and fill in. No real keys belong in this file or in git.
# Everything here is read by the Next.js server and the worker only; nothing is
# exposed to the browser.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Local/test database (scripts/local-db.mjs). This is the default.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
#
# Supabase: the project's Postgres connection string. Prefer the pooled
# ("Connection pooling", port 6543) string for the web app.
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Supabase Auth ---------------------------------------------------------
# Leave all three unset to use the local development sign-in (a password checked
# against the local database, with a signed cookie). Every session issued that
# way is labelled "Local auth" in the UI.
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Only needed when the project still signs JWTs with the legacy HS256 secret.
# Leave unset to verify asymmetric tokens via the project's JWKS endpoint.
# SUPABASE_JWT_SECRET=

# --- Supabase Storage ------------------------------------------------------
# A PRIVATE bucket. Without SUPABASE_SERVICE_ROLE_KEY, files are written to
# LOCAL_STORAGE_DIR instead and served through an authenticated route.
SUPABASE_STORAGE_BUCKET=workspace-files
LOCAL_STORAGE_DIR=.data/storage

# --- Local development auth ------------------------------------------------
# The local sign-in is an authentication bypass relative to Supabase Auth: it
# trusts a local password table and a locally signed cookie. It is OFF unless
# this is explicitly true, and it is refused outright when NODE_ENV=production.
# Leave it false once Supabase Auth is configured.
DEV_AUTH_ENABLED=true
# Signs the local session cookie. Change it; a leaked value forges sessions.
DEV_AUTH_SECRET=replace-with-a-long-random-secret

# --- OpenAI ----------------------------------------------------------------
# With no key the app runs the mock provider: the full pipeline executes, and
# every generated result is labelled as synthetic in the UI and the database.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Configurable models. Set these to the models you actually want to pay for.
OPENAI_MODEL=gpt-5.5
OPENAI_RESEARCH_MODEL=gpt-5.5
OPENAI_DEEP_RESEARCH_MODEL=o3-deep-research
OPENAI_FAST_MODEL=gpt-5.5-mini

# Prices, for turning tokens into money. Without these the UI shows token counts
# and says "price not configured" rather than inventing a number.
# See config/model-prices.json for the file form.
# OPENAI_PRICES_JSON={"prices":{"gpt-5.5":{"inputPerMTok":0,"outputPerMTok":0}}}

# --- Worker ----------------------------------------------------------------
# WORKER_ID=                      # defaults to hostname-pid
WORKER_CONCURRENCY=1
WORKER_POLL_INTERVAL_MS=1500
# A crashed worker's job becomes visible again after this many seconds.
WORKER_VISIBILITY_TIMEOUT_S=120
WORKER_HEARTBEAT_INTERVAL_MS=20000
WORKER_MAX_ATTEMPTS=3

# --- Upload limits ---------------------------------------------------------
MAX_UPLOAD_BYTES=26214400
MAX_ARCHIVE_ENTRIES=200
MAX_ARCHIVE_UNCOMPRESSED_BYTES=157286400
MAX_ARCHIVE_COMPRESSION_RATIO=120

# --- Seeding (local only) --------------------------------------------------
SEED_ADMIN_EMAIL=admin@example.invalid
SEED_ADMIN_PASSWORD=ChangeMeBeforeUse
SEED_CLIENT_EMAIL=client@example.invalid
SEED_CLIENT_PASSWORD=ChangeMeBeforeUse

# --- Local database server -------------------------------------------------
LOCAL_PG_PORT=54329
LOCAL_PG_HOST=127.0.0.1

# Development only: origins allowed to call /api from a browser on another port,
# e.g. the mobile app's Expo web preview. Comma-separated. The native iOS app
# needs no entry. Leave empty in production.
G3_CLIENT_ORIGINS=
