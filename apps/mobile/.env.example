# The Globa 3 server this app talks to. This is the ONLY configuration the app
# needs, and it is not a secret: it ends up inside the app bundle.
#
# Never put Supabase keys, database URLs or OpenAI keys here. The app signs in
# through the server and never talks to Supabase or OpenAI directly.
#
# iOS Simulator on this Mac:          http://localhost:3000
# A phone on the same Wi-Fi (Expo Go): http://<this Mac's LAN IP>:3000
# TestFlight / App Store builds:       https://<your deployed server>
EXPO_PUBLIC_API_URL=http://localhost:3000
