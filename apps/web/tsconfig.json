{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-build-check/types/**/*.ts",
    ".next-kb-preview/types/**/*.ts",
    ".next-local/types/**/*.ts",
    ".next-mobile-api-test/types/**/*.ts",
    ".next-preview/types/**/*.ts",
    ".next-prod/types/**/*.ts",
    ".next-secret-scan/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
